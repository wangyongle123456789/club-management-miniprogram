/* pages/privacy/privacy.wxss */
.privacy-title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text);
  letter-spacing: 1rpx;
}

.privacy-sub {
  font-family: var(--mono);
  font-size: 22rpx;
  color: var(--accent);
  margin-top: 8rpx;
  margin-bottom: 18rpx;
}

.privacy-section {
  margin-bottom: 26rpx;
}

.privacy-p {
  font-size: 25rpx;
  color: var(--text-secondary);
  line-height: 1.75;
  margin-bottom: 6rpx;
}

.privacy-foot {
  font-size: 22rpx;
  color: var(--text-muted);
  text-align: center;
  margin-top: 10rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed var(--border);
}
