/* pages/admin/login/login.wxss */

.login-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f7ff 0%, var(--bg) 40%);
}

/* Logo 区 */
.login-logo {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.logo-box {
  width: 120rpx;
  height: 120rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 36rpx rgba(108, 92, 231, 0.3);
  margin-bottom: 28rpx;
}

.logo-icon {
  font-size: 56rpx;
}

.login-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 8rpx;
}

.login-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 登录卡片 */
.login-card {
  width: 640rpx;
  padding: 40rpx 36rpx;
}

.input-group {
  margin-bottom: 36rpx;
}

.input-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
}

.input-field {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid var(--border);
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: var(--text);
  background: var(--bg);
  box-sizing: border-box;
  transition: border-color 0.2s;
}

.input-field:focus {
  border-color: var(--primary);
}

.input-error {
  border-color: #e74c3c;
}

.error-tip {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #e74c3c;
  line-height: 1.6;
}

/* 提交按钮 */
.login-submit-btn {
  width: 100%;
  height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff;
  border: none;
  box-shadow: 0 8rpx 28rpx rgba(108, 92, 231, 0.35);
}

.login-submit-btn[disabled] {
  opacity: 0.6;
  background: var(--text-tertiary);
  box-shadow: none;
}

/* 底部提示 */
.login-footer {
  margin-top: 48rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
  opacity: 0.7;
}
