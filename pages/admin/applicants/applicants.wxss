.applicant-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.applicant-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.applicant-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.applicant-name {
  font-size: 32rpx;
  font-weight: 600;
}

.applicant-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}

.applicant-actions {
  display: flex;
  gap: 16rpx;
}

.small {
  height: 60rpx;
  font-size: 26rpx;
  padding: 0 32rpx;
}
