/* ===== 操作栏 ===== */
.action-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

/* ===== 表单行 ===== */
.form-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.form-item {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.form-item.half {
  width: 48.6%;
}

.form-item.full {
  width: 100%;
}

.form-item .label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.form-input {
  background: var(--bg);
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: var(--text);
}

.picker-value {
  background: var(--bg);
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: var(--text);
}

/* ===== Switch 行 ===== */
.switch-row {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
}

.switch-row .label {
  font-size: 30rpx;
  color: var(--text);
}

/* ===== 详情行（查看模式） ===== */
.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
  font-size: 30rpx;
  gap: 24rpx;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-row .label {
  color: var(--text-secondary);
  flex-shrink: 0;
}

.text-wrap {
  text-align: right;
  flex: 1;
  line-height: 1.6;
}

/* ===== 图片网格 ===== */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 12rpx 0;
}

.image-item {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}

.image-item image {
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0,0,0,0.55);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  line-height: 1;
}

.image-add {
  width: 150rpx;
  height: 150rpx;
  border: 2rpx dashed var(--border);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* ===== 二维码区域 ===== */
.qr-area {
  width: 280rpx;
  height: 280rpx;
  margin: 20rpx auto;
  border: 2rpx dashed var(--border);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.qr-img {
  width: 100%;
  height: 100%;
}

.qr-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
}

.qr-icon {
  font-size: 48rpx;
}

/* ===== 底部保存区 ===== */
.save-area {
  padding: 24rpx 0 40rpx;
}

.bottom-space {
  height: 40rpx;
}
