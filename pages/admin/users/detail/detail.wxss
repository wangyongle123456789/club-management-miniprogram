.detail-row {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
  font-size: 30rpx;
}

.detail-row:last-child {
  border-bottom: none;
}

.label {
  color: var(--text-secondary);
}

.status-tag {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.status-tag.normal {
  background: #dcfce7;
  color: var(--success);
}

.status-tag.disabled {
  background: #fee2e2;
  color: var(--danger);
}

/* 危险操作区 */
.danger-zone {
  margin-top: 48rpx;
}

.danger-title {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 20rpx;
  padding-left: 8rpx;
}

.delete-btn {
  background: #fff;
  border: 1rpx solid #e74c3c;
  border-radius: 16rpx;
  padding: 24rpx 0;
  text-align: center;
}

.delete-btn text {
  font-size: 28rpx;
  color: #e74c3c;
  font-weight: 600;
}

.delete-btn:active {
  background: #fff5f5;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}
