.log-list {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 0 24rpx;
}

.log-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
  font-size: 28rpx;
}

.log-item:last-child {
  border-bottom: none;
}

.log-time {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 8rpx;
}

.log-action {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.log-detail {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.log-operator {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}
