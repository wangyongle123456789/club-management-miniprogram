.admin-list {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 0 24rpx;
}

.admin-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border);
  font-size: 30rpx;
}

.admin-row:last-child {
  border-bottom: none;
}

.admin-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.admin-role {
  color: var(--text-secondary);
  font-size: 26rpx;
}

.admin-delete {
  font-size: 24rpx;
  color: var(--danger);
  padding: 8rpx 16rpx;
  background: var(--danger-light);
  border-radius: 10rpx;
}

.add-panel {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.add-input {
  height: 80rpx;
  padding: 0 20rpx;
  margin-bottom: 20rpx;
  background: var(--bg);
  border-radius: 12rpx;
  font-size: 28rpx;
}

.add-btn {
  margin-top: 10rpx;
}

.add-toggle-btn {
  margin-top: 10rpx;
}

.add-btn.disabled {
  opacity: 0.6;
  pointer-events: none;
}
