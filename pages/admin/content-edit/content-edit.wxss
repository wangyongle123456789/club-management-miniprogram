/* 新增按钮 */
.btn-add {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 80rpx;
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(108, 92, 231, 0.25);
}

.btn-add-icon {
  font-size: 36rpx;
  font-weight: 400;
}

/* 空状态 */
.empty-tip {
  text-align: center;
  color: var(--text-tertiary);
  font-size: 28rpx;
  padding: 80rpx 0;
}

/* 列表卡片 */
.list-card {
  padding: 0 24rpx;
  margin-bottom: 16rpx;
}

.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.list-item:last-child {
  border-bottom: none;
}

.list-main {
  flex: 1;
  min-width: 0;
}

.list-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-text {
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.5;
}

.list-meta {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.status-tag {
  color: var(--primary);
}

/* 轮播图列表项 */
.banner-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.banner-thumb {
  width: 120rpx;
  height: 80rpx;
  border-radius: 12rpx;
  background: var(--bg);
}

.banner-info {
  flex: 1;
  min-width: 0;
}

.list-actions {
  display: flex;
  gap: 24rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.action-edit {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 500;
}

.action-del {
  font-size: 26rpx;
  color: #e74c3c;
  font-weight: 500;
}

/* ====== 编辑表单 ====== */
.form-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid var(--border);
  border-radius: 16rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: var(--text);
  background: var(--bg);
  box-sizing: border-box;
}

.form-input:focus {
  border-color: var(--primary);
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  border: 2rpx solid var(--border);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: var(--text);
  background: var(--bg);
  box-sizing: border-box;
}

/* 选择器 */
.picker-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.picker-option {
  padding: 14rpx 28rpx;
  border-radius: 20rpx;
  background: var(--bg);
  border: 2rpx solid var(--border);
  font-size: 26rpx;
  color: var(--text-secondary);
  transition: all 0.2s;
}

.picker-active {
  background: var(--primary-light);
  border-color: var(--primary);
  color: var(--primary);
  font-weight: 600;
}

/* 编辑按钮组 */
.edit-btns {
  display: flex;
  gap: 24rpx;
  margin-top: 36rpx;
}

.btn-cancel {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  background: var(--bg);
  color: var(--text-secondary);
  font-size: 28rpx;
  border: 2rpx solid var(--border);
}

.btn-danger {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #e74c3c, #ff6b6b);
  color: #fff;
  font-size: 28rpx;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(231, 76, 60, 0.25);
}

/* 删除确认弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-card {
  width: 580rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx 36rpx 28rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  text-align: center;
  margin-bottom: 16rpx;
}

.modal-body {
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: center;
  margin-bottom: 32rpx;
  line-height: 1.6;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
}
