/* pages/gallery/detail/detail.wxss */
.detail-hero {
  position: relative;
  width: 100%;
  height: 420rpx;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.15);
}

.detail-cover {
  width: 100%;
  height: 100%;
}

.detail-hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 32rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.85), rgba(0, 0, 0, 0.2), transparent);
  color: #fff;
}

.detail-tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.detail-tag {
  font-size: 20rpx;
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(108, 92, 231, 0.85);
  color: #fff;
  backdrop-filter: blur(8rpx);
}

.detail-title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
  margin-bottom: 12rpx;
}

.detail-sub {
  font-size: 26rpx;
  opacity: 0.95;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.detail-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.detail-meta {
  font-size: 22rpx;
  opacity: 0.85;
}

.detail-story-card {
  margin-bottom: 24rpx;
}

.story-paragraph {
  font-size: 28rpx;
  line-height: 1.85;
  color: #2d3436;
  margin-bottom: 24rpx;
  text-align: justify;
}

.detail-highlights {
  margin-top: 30rpx;
  padding-top: 24rpx;
  border-top: 2rpx dashed #dfe6e9;
}

.highlight-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.highlight-dot {
  color: #6c5ce7;
  font-size: 28rpx;
  line-height: 1.4;
}

.highlight-text {
  flex: 1;
  font-size: 26rpx;
  color: #636e72;
  line-height: 1.5;
}

.detail-photos-card {
  margin-bottom: 24rpx;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.photo-cell {
  position: relative;
  border-radius: 16rpx;
  overflow: hidden;
  aspect-ratio: 1;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.detail-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.detail-actions .btn {
  width: 100%;
  text-align: center;
}

.detail-tip {
  text-align: center;
  font-size: 22rpx;
  color: #b2bec3;
  margin-bottom: 40rpx;
}
