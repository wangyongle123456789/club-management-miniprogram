.gallery-head {
  margin-bottom: 24rpx;
}

/* ===== 精选大图 ===== */
.g-featured {
  position: relative;
  height: 380rpx;
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 12rpx 36rpx rgba(108, 92, 231, 0.18);
  transition: transform 0.2s ease;
}
.g-featured:active {
  transform: scale(0.985);
}
.g-featured-img {
  width: 100%;
  height: 100%;
  display: block;
}
.g-featured-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 24rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.28) 0%, transparent 32%, transparent 55%, rgba(0, 0, 0, 0.72) 100%);
}
.g-tag {
  align-self: flex-start;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #fff;
  background: rgba(108, 92, 231, 0.85);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
}
.g-featured-bottom {
  color: #fff;
}
.g-featured-title {
  font-size: 36rpx;
  font-weight: 800;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.4);
  margin-bottom: 8rpx;
}
.g-featured-count {
  font-size: 24rpx;
  opacity: 0.9;
}
.g-featured-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.92);
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.4);
}

/* ===== 2 列等高网格 ===== */
.g-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}
.g-cell {
  position: relative;
  height: 300rpx;
  border-radius: 22rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 6rpx 20rpx rgba(108, 92, 231, 0.10);
  transition: transform 0.2s ease;
}
.g-cell:active {
  transform: scale(0.97);
}
.g-cell-img {
  width: 100%;
  height: 100%;
  display: block;
}
.g-cell-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 28rpx 20rpx 18rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  background: linear-gradient(transparent 0%, rgba(0, 0, 0, 0.68) 100%);
  color: #fff;
}
.g-cell-title {
  font-size: 28rpx;
  font-weight: 600;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.35);
}
.g-cell-desc {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.9);
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.35);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.g-cell-count {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.85);
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.35);
}
