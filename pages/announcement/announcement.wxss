.announce-list {
  display: flex;
  flex-direction: column;
}

.announce-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
  transition: all 0.2s ease;
}

.announce-item:active {
  opacity: 0.75;
}

.announce-item:last-child {
  border-bottom: none;
}

.announce-marker {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 14rpx;
  background: var(--primary-gradient);
  box-shadow: 0 0 0 8rpx var(--primary-light);
}

.announce-body {
  flex: 1;
}

.announce-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.announce-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

.announce-tag {
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.announce-tag.notice { background: var(--primary-light); color: var(--primary); }
.announce-tag.activity { background: var(--success-light); color: var(--success); }
.announce-tag.important { background: var(--pink-light); color: var(--pink); }

.announce-arrow {
  font-size: 36rpx;
  color: var(--text-secondary);
  opacity: 0.6;
  flex-shrink: 0;
}
