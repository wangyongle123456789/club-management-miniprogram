<!--pages/profile/profile.wxml-->
<view class="container fade-in">
  <view class="code-label">// profile.me()</view>
  <!-- 用户信息 -->
  <view class="card card-border user-card">
    <block wx:if="{{currentUser}}">
      <view class="user-avatar">👤</view>
      <view class="user-name">{{currentUser.name}}</view>
      <view class="user-id">学号：{{currentUser.username}}</view>
      <view class="logout-link" bindtap="handleLogout">退出登录</view>
    </block>

    <block wx:elif="{{showLogin}}">
      <view class="user-avatar default">👤</view>
      <view class="login-title">账号登录</view>
      <view class="login-form">
        <input class="login-input" type="number" placeholder="学号" data-field="username" bindinput="onLoginInput" value="{{loginForm.username}}" />
        <input class="login-input" type="password" placeholder="密码" data-field="password" bindinput="onLoginInput" value="{{loginForm.password}}" />
        <text class="login-error" wx:if="{{loginError}}">{{loginError}}</text>
        <button class="btn login-submit-btn {{isLoggingIn ? 'disabled' : ''}}" bindtap="handleLogin">{{isLoggingIn ? '登录中...' : '登录'}}</button>
      </view>
      <view class="login-links">
        <text class="link" bindtap="goToRegister">注册新账号</text>
        <text class="link" bindtap="toggleLogin">返回</text>
      </view>
    </block>

    <block wx:else>
      <view class="user-avatar default">👤</view>
      <view class="user-name">未登录</view>
      <view class="login-actions">
        <view class="btn btn-primary action-btn" bindtap="toggleLogin">登录</view>
        <view class="btn btn-outline action-btn" bindtap="goToRegister">注册</view>
      </view>
    </block>
  </view>

  <!-- 数据统计（仅登录后显示） -->
  <view class="stats-row" wx:if="{{currentUser}}">
    <view class="stat-item" bindtap="goToPage" data-url="/pages/profile/my-registrations/my-registrations" data-needlogin="{{true}}">
      <text class="stat-num">{{stats.registrations}}</text>
      <text class="stat-label">我的报名</text>
    </view>
    <view class="stat-item" bindtap="goToPage" data-url="/pages/profile/my-favorites/my-favorites" data-needlogin="{{true}}">
      <text class="stat-num">{{stats.favorites}}</text>
      <text class="stat-label">我的收藏</text>
    </view>
    <view class="stat-item" bindtap="goToPage" data-url="/pages/profile/history/history" data-needlogin="{{false}}">
      <text class="stat-num">{{stats.history}}</text>
      <text class="stat-label">历史浏览</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="card card-border menu-card">
    <view class="menu-item" wx:for="{{menuList}}" wx:key="title" data-url="{{item.url}}" data-needlogin="{{item.needLogin}}" bindtap="goToPage">
      <view class="menu-icon menu-icon-{{index + 1}}">
        <text>{{item.icon}}</text>
      </view>
      <text class="menu-title">{{item.title}}</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 隐私政策 -->
  <view class="card card-border menu-card">
    <view class="menu-item" bindtap="goToPrivacy">
      <view class="menu-icon" style="background: var(--accent-light);">
        <text>🔒</text>
      </view>
      <text class="menu-title">隐私政策</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 管理员入口 -->
  <view class="card card-border menu-card">
    <view class="menu-item" bindtap="goToAdmin">
      <view class="menu-icon" style="background: var(--pink-light);">
        <text>{{isAdmin ? '🔒' : '🔑'}}</text>
      </view>
      <text class="menu-title">{{isAdmin ? '后台管理' : '管理员登录'}}</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>
