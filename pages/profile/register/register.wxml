<!--pages/profile/register/register.wxml-->
<view class="container fade-in">
  <!-- 步骤一：账号设置 -->
  <view class="card" wx:if="{{step === 1}}">
    <view class="section-title">🔐 创建账号</view>
    <view class="step-hint">先设置登录账号和密码</view>

    <view class="register-form">
      <view class="form-item">
        <text class="form-label">姓名 <text class="required">*</text></text>
        <input class="form-input" placeholder="请输入真实姓名" data-field="name" bindinput="onInput" value="{{form.name}}" />
      </view>

      <view class="form-item">
        <text class="form-label">学号（登录账号）<text class="required">*</text></text>
        <input class="form-input" type="number" placeholder="请输入学号，至少4位数字" data-field="username" bindinput="onInput" value="{{form.username}}" />
      </view>

      <view class="form-item">
        <text class="form-label">设置密码 <text class="required">*</text></text>
        <view class="pwd-wrap">
          <input class="form-input" type="{{showPwd ? 'text' : 'password'}}" placeholder="至少6位" data-field="password" bindinput="onInput" value="{{form.password}}" />
          <view class="eye-btn" bindtap="togglePwd">
            <text>{{showPwd ? '🙈' : '👁'}}</text>
          </view>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">确认密码 <text class="required">*</text></text>
        <view class="pwd-wrap">
          <input class="form-input" type="{{showConfirmPwd ? 'text' : 'password'}}" placeholder="再次输入密码" data-field="confirmPwd" bindinput="onInput" value="{{form.confirmPwd}}" />
          <view class="eye-btn" bindtap="toggleConfirmPwd">
            <text>{{showConfirmPwd ? '🙈' : '👁'}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="btn btn-primary save-btn" bindtap="nextStep">下一步</view>
  </view>

  <!-- 步骤二：完善资料 -->
  <view class="card" wx:if="{{step === 2}}">
    <view class="section-title">👤 完善资料</view>
    <view class="step-hint">选填，后续可在个人中心修改</view>

    <view class="register-form">
      <view class="form-item">
        <text class="form-label">专业</text>
        <input class="form-input" placeholder="如：计算机科学与技术" data-field="major" bindinput="onInput" value="{{form.major}}" />
      </view>

      <view class="form-item">
        <text class="form-label">手机号</text>
        <input class="form-input" type="number" placeholder="请输入手机号" data-field="phone" bindinput="onInput" value="{{form.phone}}" />
      </view>
    </view>

    <view class="step-actions">
      <view class="btn btn-outline prev-btn" bindtap="prevStep">上一步</view>
      <view class="btn btn-primary save-btn {{submitting ? 'disabled' : ''}}" bindtap="register">{{submitting ? '注册中...' : '完成注册'}}</view>
    </view>
  </view>
</view>
