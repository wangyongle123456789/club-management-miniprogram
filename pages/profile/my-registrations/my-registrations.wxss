.header-card {
  margin-bottom: 24rpx;
}

.registration-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.registration-card {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.registration-card:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.reg-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.reg-name {
  font-size: 34rpx;
  font-weight: 700;
}

.reg-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 20rpx;
}

.cancel-btn {
  height: 60rpx;
  font-size: 24rpx;
  width: 160rpx;
}
