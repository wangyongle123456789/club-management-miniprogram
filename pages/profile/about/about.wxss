.about-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 72rpx 48rpx;
  background: linear-gradient(160deg, #ffffff 60%, #f0edff 100%);
  position: relative;
  overflow: hidden;
}

.about-card::before {
  content: '';
  position: absolute;
  top: -50rpx;
  right: -50rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: var(--primary-gradient);
  opacity: 0.05;
}

.about-badge {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  background: var(--primary-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 16rpx 40rpx rgba(108, 92, 231, 0.25);
  position: relative;
  z-index: 1;
}

.about-title {
  font-size: 44rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
  background: var(--primary-gradient);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  position: relative;
  z-index: 1;
}

.about-version {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: var(--primary);
  background: var(--primary-light);
  margin-bottom: 36rpx;
  font-weight: 500;
  position: relative;
  z-index: 1;
}

.about-desc {
  font-size: 30rpx;
  color: var(--text-secondary);
  line-height: 1.9;
  position: relative;
  z-index: 1;
  max-width: 500rpx;
}

.about-features {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
  margin-top: 32rpx;
  position: relative;
  z-index: 1;
}

.feature-tag {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  background: var(--bg);
}

/* ===== 重构后的关于页 ===== */
.about-logo {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}
.about-logo-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 32rpx;
  box-shadow: 0 12rpx 30rpx rgba(108, 92, 231, 0.22);
  border: 3rpx solid #fff;
}
.about-name {
  text-align: center;
  font-size: 42rpx;
  font-weight: 800;
  background: var(--primary-gradient);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 16rpx;
}
.about-intro {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.9;
  text-align: justify;
  margin: 8rpx 0 28rpx;
}
.about-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  width: 100%;
}
.about-meta .fact-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 4rpx;
  border-bottom: 1rpx solid var(--border);
}
.about-meta .fact-item:last-child {
  border-bottom: none;
}
.about-meta .fact-label {
  font-size: 26rpx;
  color: var(--text-muted);
}
.about-meta .fact-value {
  font-size: 26rpx;
  color: var(--text);
  font-weight: 600;
  text-align: right;
  max-width: 60%;
}
.about-version-card {
  margin-top: 24rpx;
}
.about-version {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary);
  margin: 8rpx 0 12rpx;
}
.about-tip {
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 1.7;
}
