.detail-cover {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.detail-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.detail-logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  margin-right: 24rpx;
  background: #fff;
  flex-shrink: 0;
}

.detail-name-group {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
}

.detail-name {
  font-size: 40rpx;
  font-weight: 800;
  background: var(--primary-gradient);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.detail-meta {
  display: flex;
  gap: 24rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.detail-intro,
.detail-contact,
.detail-status {
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.8;
  white-space: pre-line;
}

.detail-status {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.honor-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.honor-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.honor-badge {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--primary-light);
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 24rpx;
  background: #ffffff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.action-bar .btn {
  flex: 1;
}

.action-bar .btn::after {
  border: none;
}

/* 防止底部固定栏压住最后一张卡片 */
.container {
  padding-bottom: 160rpx;
}

.disabled {
  opacity: 0.6;
  pointer-events: none;
}

.share-btn::after {
  border: none;
}

/* 社团概况 */
.detail-facts {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.story-link {
  margin-top: 20rpx;
  display: inline-block;
  font-size: 26rpx;
  font-weight: 600;
  color: #6c5ce7;
  background: rgba(108, 92, 231, 0.08);
  padding: 14rpx 24rpx;
  border-radius: 14rpx;
}

.fact-item {
  display: flex;
  align-items: baseline;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.fact-item:last-child {
  border-bottom: none;
}

.fact-label {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.fact-value {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
}

/* 部门设置 */
.dept-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.dept-item {
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: var(--primary-light, #f3f0ff);
}

.dept-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary, #6c5ce7);
  margin-bottom: 8rpx;
}

.dept-desc {
  font-size: 25rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}

.fav-btn, .apply-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
}
