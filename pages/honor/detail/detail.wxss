/* pages/honor/detail/detail.wxss */
@import "../../gallery/detail/detail.wxss";

.honor-hero .detail-hero-mask {
  justify-content: flex-end;
}

.honor-badge {
  align-self: flex-start;
  font-size: 24rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #fdcb6e, #e17055);
  color: #fff;
  font-weight: 700;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(225, 112, 85, 0.35);
}

.honor-title-card {
  margin-bottom: 24rpx;
}

.honor-level-tag {
  display: inline-block;
  font-size: 24rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #fdcb6e, #e17055);
  color: #fff;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.detail-title.dark {
  color: #2d3436;
}

.honor-summary {
  font-size: 30rpx;
  line-height: 1.7;
  color: #6c5ce7;
  font-weight: 600;
  padding: 24rpx;
  background: rgba(108, 92, 231, 0.06);
  border-radius: 16rpx;
  margin-bottom: 28rpx;
}
