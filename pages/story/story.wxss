/* pages/story/story.wxss */
.story-hero {
  position: relative;
  z-index: 1;
  padding: 48rpx 36rpx 36rpx;
  text-align: center;
}

.story-badge {
  display: inline-block;
  font-size: 24rpx;
  color: #6c5ce7;
  background: rgba(108, 92, 231, 0.1);
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  margin-bottom: 24rpx;
}

.story-title {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.4;
  background: var(--primary-gradient);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.story-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #9b93b5;
  letter-spacing: 2rpx;
}

.story-divider {
  width: 96rpx;
  height: 6rpx;
  margin: 28rpx auto 0;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #7c6cf0, #4b3cc4);
}

.story-chapter {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 24rpx;
  margin: 0 24rpx 28rpx;
  padding: 32rpx 28rpx;
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(108, 92, 231, 0.08);
}

.chapter-no {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #7c6cf0, #6c5ce7);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(108, 92, 231, 0.3);
}

.chapter-body {
  flex: 1;
  min-width: 0;
}

.chapter-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2d2640;
  margin-bottom: 18rpx;
  line-height: 1.4;
}

.chapter-para {
  font-size: 28rpx;
  color: #4a4458;
  line-height: 1.9;
  margin-bottom: 16rpx;
  text-align: justify;
}

.chapter-para:last-child {
  margin-bottom: 0;
}

.story-end {
  position: relative;
  z-index: 1;
  text-align: center;
  font-size: 26rpx;
  color: #9b93b5;
  padding: 20rpx 40rpx 60rpx;
  line-height: 1.8;
}
