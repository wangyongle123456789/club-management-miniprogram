/* ===== 活动掠影 ===== */
.strip-card {
  padding: 28rpx 24rpx 24rpx;
}
.strip {
  height: 280rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(108, 92, 231, 0.12);
}
.strip-img {
  width: 100%;
  height: 100%;
}

/* ===== 社团简介（代码窗口内） ===== */
.club-intro-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.club-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
  box-shadow: 0 8rpx 24rpx rgba(108, 92, 231, 0.2);
  border: 3rpx solid #fff;
}

.club-intro-title {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.club-name {
  font-size: 38rpx;
  font-weight: 800;
  background: var(--primary-gradient);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.club-intro-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.85;
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: rgba(108, 92, 231, 0.05);
  border-radius: 16rpx;
  border-left: 5rpx solid var(--accent);
}

.club-intro-meta {
  display: flex;
  gap: 20rpx;
  margin-bottom: 28rpx;
  flex-wrap: wrap;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  background: rgba(108, 92, 231, 0.06);
  padding: 12rpx 20rpx;
  border-radius: 24rpx;
  font-weight: 500;
}

.meta-item text {
  font-size: 22rpx;
}

.intro-apply-btn {
  width: 100%;
}

/* ===== 公告/导航卡片标题修正 ===== */
.announcement-card {
  padding-bottom: 8rpx;
}

.nav-grid-card {
  padding: 28rpx 16rpx;
}

/* 不同颜色图标（计算机风：紫/青/粉/橙/绿 渐变） */
.nav-icon-1 { background: linear-gradient(135deg, #a29bfe, #6c5ce7); color: #fff; }
.nav-icon-2 { background: linear-gradient(135deg, #00c2ff, #00cec9); color: #fff; }
.nav-icon-3 { background: linear-gradient(135deg, #fd79a8, #e84393); color: #fff; }
.nav-icon-4 { background: linear-gradient(135deg, #a29bfe, #6c5ce7); color: #fff; }
.nav-icon-5 { background: linear-gradient(135deg, #55efc4, #00b894); color: #fff; }
.nav-icon-6 { background: linear-gradient(135deg, #00c2ff, #6c5ce7); color: #fff; }
.nav-icon-8 { background: linear-gradient(135deg, #fd79a8, #e17055); color: #fff; }

/* 社团活动全景首页入口 */
.bp-home-card { overflow: hidden; }
.bp-swiper { white-space: nowrap; margin: 4rpx 0 20rpx; }
.bp-slide {
  display: inline-block;
  width: 300rpx;
  margin-right: 18rpx;
  border-radius: 22rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(108, 92, 231, 0.12);
  vertical-align: top;
  transition: transform .15s ease;
}
.bp-slide:active { transform: scale(0.97); }
.bp-slide-top {
  position: relative;
  height: 150rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}
.bp-slide-no {
  font-family: var(--mono);
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.88);
}
.bp-slide-icon {
  font-size: 64rpx;
  filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.15));
}
.bp-slide-body {
  padding: 20rpx 22rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.bp-slide-cat { font-size: 22rpx; font-weight: 600; }
.bp-slide-title {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.35;
  height: 74rpx;
  overflow: hidden;
}
.bp-slide-theme {
  font-size: 22rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.more-btn {
  margin-top: 4rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 600;
  padding: 14rpx 0;
}

/* ===== 数据说服带 ===== */
.stats-band {
  display: flex;
  align-items: stretch;
  background: var(--bg-card);
  border-radius: 28rpx;
  padding: 30rpx 8rpx;
  border: 1rpx solid rgba(108, 92, 231, 0.14);
  box-shadow: 0 8rpx 32rpx rgba(108, 92, 231, 0.10), inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
}
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  position: relative;
  transition: transform .15s ease;
}
.stat-item:active { transform: scale(0.94); }
.stat-item:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 1rpx;
  height: 54rpx;
  background: rgba(108, 92, 231, 0.14);
}
.stat-item .stat-num {
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.1;
}
.stat-label {
  font-size: 22rpx;
  color: var(--text-muted);
  letter-spacing: 0.5rpx;
}

/* ===== 四大门派预览 ===== */
.sect-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin: 4rpx 0 16rpx;
}
.sect-card {
  width: 48.6%;
  margin-bottom: 18rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 22rpx;
  padding: 24rpx 22rpx;
  border: 1rpx solid rgba(108, 92, 231, 0.10);
  border-top: 5rpx solid var(--sc, #6c5ce7);
  box-shadow: 0 6rpx 20rpx rgba(108, 92, 231, 0.08);
  transition: transform .15s ease;
}
.sect-card:active { transform: scale(0.97); }
.sect-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 14rpx;
}
.sect-icon { font-size: 50rpx; }
.sect-name-wrap {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.sect-name {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text);
}
.sect-dept {
  font-size: 20rpx;
  color: var(--text-muted);
}
.sect-slogan {
  font-size: 23rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  margin-bottom: 16rpx;
  min-height: 68rpx;
}
.sect-skills {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.sect-skill {
  font-size: 20rpx;
  color: var(--sc, #6c5ce7);
  background: rgba(108, 92, 231, 0.08);
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

/* ===== 底部招新 CTA ===== */
.cta-banner {
  position: relative;
  border-radius: 32rpx;
  padding: 46rpx 34rpx;
  overflow: hidden;
  background: linear-gradient(160deg, #141833 0%, #1d1f3d 55%, #271a3c 100%);
  box-shadow: 0 22rpx 56rpx rgba(20, 16, 40, 0.38);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  text-align: center;
}
.cta-banner::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(120, 130, 255, 0.10) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(120, 130, 255, 0.10) 1rpx, transparent 1rpx);
  background-size: 40rpx 40rpx;
  opacity: 0.6;
}
.cta-glow {
  position: absolute;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  filter: blur(70rpx);
  background: radial-gradient(circle, rgba(0, 194, 255, 0.45), transparent 70%);
  top: -110rpx;
  right: -60rpx;
}
.cta-glow2 {
  position: absolute;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  filter: blur(70rpx);
  background: radial-gradient(circle, rgba(124, 92, 231, 0.5), transparent 70%);
  bottom: -110rpx;
  left: -50rpx;
}
.cta-inner { position: relative; z-index: 1; }
.cta-title {
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}
.cta-sub {
  color: rgba(255, 255, 255, 0.78);
  font-size: 26rpx;
  margin-top: 16rpx;
}
.cta-sub .mono { color: #7fe3ff; }
.cta-progress {
  height: 16rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 999rpx;
  overflow: hidden;
  margin: 28rpx 0 14rpx;
}
.cta-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #00c2ff, #6c5ce7);
  border-radius: 999rpx;
}
.cta-remaining {
  color: #ffd166;
  font-size: 24rpx;
  margin-bottom: 30rpx;
}
.cta-btn {
  background: var(--primary-gradient);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(108, 92, 231, 0.4);
}
.cta-btn:active { transform: scale(0.97); }

