/* pages/easter/easter.wxss */
.easter-page {
  min-height: 100vh;
  padding: 80rpx 48rpx 60rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: radial-gradient(120% 80% at 50% 0%, #2a2150 0%, #1a1430 45%, #120e22 100%);
  overflow: hidden;
}

.easter-glow {
  position: absolute;
  top: -120rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 520rpx;
  height: 520rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(108, 92, 231, 0.55), transparent 70%);
  filter: blur(30rpx);
}

.easter-card {
  position: relative;
  z-index: 2;
  width: 100%;
  margin-top: 40rpx;
  padding: 56rpx 44rpx 48rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  box-shadow: 0 30rpx 80rpx rgba(0, 0, 0, 0.4);
  text-align: center;
}

.easter-emoji {
  font-size: 96rpx;
  line-height: 1;
  margin-bottom: 20rpx;
  animation: pop 1.6s ease-in-out infinite;
}
@keyframes pop {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.12); }
}

.easter-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 12rpx;
}
.easter-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 36rpx;
}

.easter-perk {
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(0, 194, 255, 0.18), rgba(108, 92, 231, 0.18));
  border: 1rpx solid rgba(0, 194, 255, 0.35);
  margin-bottom: 32rpx;
  text-align: left;
}
.easter-perk-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #6ad0ff;
  margin-bottom: 12rpx;
}
.easter-perk-text {
  font-size: 28rpx;
  color: #f0f0ff;
  line-height: 1.8;
}

.easter-poem {
  font-family: var(--mono, monospace);
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.75);
  line-height: 1.9;
  margin-bottom: 40rpx;
  white-space: pre-line;
}

.easter-btn {
  width: 100%;
  margin-bottom: 20rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
  line-height: 2.6;
}
.easter-btn.primary {
  background: linear-gradient(135deg, #6c5ce7, #a29bfe);
  color: #fff;
  box-shadow: 0 12rpx 30rpx rgba(108, 92, 231, 0.45);
}
.easter-btn.ghost {
  background: rgba(255, 255, 255, 0.1);
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, 0.25);
}
.easter-btn.share {
  background: transparent;
  color: rgba(255, 255, 255, 0.55);
  font-weight: 500;
}
.easter-btn::after {
  border: none;
}

.easter-foot {
  position: relative;
  z-index: 2;
  margin-top: 40rpx;
  font-family: var(--mono, monospace);
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.35);
}
