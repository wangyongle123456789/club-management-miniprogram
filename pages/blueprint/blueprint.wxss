/* pages/blueprint/blueprint.wxss */

/* 顶部头 */
.bp-head { padding: 36rpx 30rpx 32rpx; margin-bottom: 24rpx; }
.bp-title { font-size: 44rpx; font-weight: 800; letter-spacing: 1rpx; margin-bottom: 10rpx; }
.bp-sub { font-size: 26rpx; color: var(--text-secondary); margin-bottom: 30rpx; }

.bp-stats { display: flex; gap: 20rpx; }
.bp-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 22rpx 0;
  background: var(--bg);
  border-radius: 22rpx;
}
.bp-stat .stat-num { font-size: 38rpx; margin-bottom: 6rpx; }
.bp-stat text:last-child { font-size: 22rpx; color: var(--text-secondary); }

/* 分类 tab */
.cat-bar { white-space: nowrap; margin-bottom: 26rpx; }
.cat-item {
  display: inline-flex;
  padding: 12rpx 26rpx;
  border-radius: 30rpx;
  margin-right: 14rpx;
  background: var(--bg);
  color: var(--text-secondary);
  font-size: 24rpx;
  font-weight: 500;
  border: 1rpx solid var(--border);
  transition: all .15s ease;
}
.cat-item.active {
  background: var(--primary-gradient);
  color: #fff;
  border-color: transparent;
  box-shadow: 0 6rpx 20rpx rgba(108, 92, 231, 0.28);
}

/* 卡片墙 */
.bp-list { display: flex; flex-direction: column; gap: 22rpx; }

.bp-card {
  position: relative;
  overflow: hidden;
  padding: 30rpx 26rpx 26rpx 34rpx;
  --c: var(--primary);
  transition: transform .15s ease, box-shadow .15s ease;
}
.bp-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 22rpx;
  bottom: 22rpx;
  width: 6rpx;
  border-radius: 0 3rpx 3rpx 0;
  background: var(--c);
}
.bp-card::after {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: var(--c);
  opacity: 0.05;
  pointer-events: none;
}
.bp-watermark {
  position: absolute;
  right: 22rpx;
  top: 2rpx;
  font-family: var(--mono);
  font-size: 88rpx;
  font-weight: 800;
  line-height: 1;
  color: var(--c);
  opacity: 0.09;
  pointer-events: none;
}
.bp-card:active { transform: scale(0.98); }

.bp-card-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16rpx; }

.bp-icon {
  width: 82rpx;
  height: 82rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.bp-card-head { display: flex; flex-direction: column; align-items: flex-end; gap: 10rpx; }
.bp-no {
  font-family: var(--mono);
  font-size: 22rpx;
  color: var(--text-muted);
  padding: 4rpx 12rpx;
  background: var(--bg);
  border-radius: 10rpx;
}
.bp-cat {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
}

.bp-name { font-size: 32rpx; font-weight: 700; line-height: 1.35; margin-bottom: 8rpx; }
.bp-theme {
  font-size: 25rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
  font-weight: 500;
}
.bp-summary {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  padding: 18rpx;
  background: var(--bg);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.bp-tags { display: flex; flex-wrap: wrap; }
.bp-tag {
  display: inline-flex;
  padding: 5rpx 14rpx;
  background: rgba(108, 92, 231, 0.06);
  color: var(--text-secondary);
  border-radius: 12rpx;
  font-size: 22rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
}

.bp-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 10rpx;
}
.bp-time { font-size: 22rpx; color: var(--text-muted); }
.bp-more { font-size: 24rpx; font-weight: 600; }

/* 底部 CTA */
.bp-cta { text-align: center; padding: 38rpx 32rpx; margin-top: 8rpx; margin-bottom: 8rpx; }
.bp-cta-title { font-size: 30rpx; font-weight: 700; margin-bottom: 8rpx; }
.bp-cta-sub { font-size: 24rpx; color: var(--text-secondary); margin-bottom: 28rpx; }
.bp-cta .btn { width: 100%; }
