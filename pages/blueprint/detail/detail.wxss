/* pages/blueprint/detail/detail.wxss */

/* Hero */
.dt-hero {
  position: relative;
  overflow: hidden;
  padding: 48rpx 34rpx 44rpx;
  border-radius: 28rpx;
  text-align: center;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, var(--c) 0%, var(--c) 100%);
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.12);
}
.dt-hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(255,255,255,0.12) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(255,255,255,0.12) 1rpx, transparent 1rpx);
  background-size: 40rpx 40rpx;
  opacity: 0.35;
}
.dt-glow {
  position: absolute;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.25), transparent 70%);
  top: -90rpx;
  right: -70rpx;
  filter: blur(30rpx);
}

.dt-icon {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.18);
  backdrop-filter: blur(10rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin: 0 auto 18rpx;
}

.dt-meta-pill {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 20rpx;
  background: rgba(255,255,255,0.16);
  border-radius: 999rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,0.92);
  margin-bottom: 14rpx;
}
.dt-no { font-family: var(--mono); font-weight: 600; }
.dt-divider { opacity: 0.6; }
.dt-cat { font-weight: 500; }

.dt-title {
  position: relative;
  font-size: 38rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.3;
  margin-bottom: 10rpx;
}
.dt-theme {
  position: relative;
  font-size: 26rpx;
  color: rgba(255,255,255,0.88);
  font-weight: 500;
}

/* 通用文字 */
.dt-text {
  font-size: 27rpx;
  color: var(--text-secondary);
  line-height: 1.85;
  margin-bottom: 16rpx;
}
.dt-text:last-child { margin-bottom: 0; }

.dt-summary {
  font-size: 30rpx;
  color: var(--text);
  font-weight: 500;
  line-height: 1.7;
  padding: 18rpx 20rpx;
  background: var(--bg);
  border-radius: 16rpx;
}

/* 亮点 */
.dt-highlight {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 16rpx;
  font-size: 27rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}
.dt-highlight:last-child { margin-bottom: 0; }
.dt-bullet {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  margin-top: 2rpx;
}

/* 流程时间轴 */
.dt-step {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding-left: 60rpx;
  margin-bottom: 26rpx;
}
.dt-step:last-child { margin-bottom: 0; }
.dt-step-idx {
  position: absolute;
  left: 0;
  top: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--c);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--mono);
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
}
.dt-step::before {
  content: '';
  position: absolute;
  left: 21rpx;
  top: 44rpx;
  bottom: -26rpx;
  width: 2rpx;
  background: var(--border);
}
.dt-step:last-child::before { display: none; }
.dt-step-text {
  flex: 1;
  font-size: 27rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  padding-top: 4rpx;
}

/* 活动信息 */
.dt-meta-card { margin-bottom: 24rpx; }
.dt-meta-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 14rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}
.dt-meta-row:last-child { margin-bottom: 0; }
.dt-meta-ico { font-size: 28rpx; width: 36rpx; text-align: center; }

/* 底部报名 */
.dt-cta { margin: 4rpx 0 24rpx; width: 100%; }
